{
  "name": "space-portal-temp",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:resetpnpm": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && pnpm store path | xargs rm -rf && rm -rf .pnpm-store && rm pnpm-lock.yaml",
    "build": "pnpm -r run build",
    "start:backend": "pnpm --filter @slfcp/backend prod",
    "dev:backend": "pnpm --filter @slfcp/backend dev",
    "dev:frontend": "pnpm --filter @slfcp/frontend dev",
    "dev:env": "docker compose -f apps/dev-env/docker-compose.yml up -d --build",
    "dev:env:down": "docker compose -f apps/dev-env/docker-compose.yml down",
    "dev:env:logs": "docker compose -f apps/dev-env/docker-compose.yml logs -f",
    "dev:env:reset": "docker compose -f apps/dev-env/docker-compose.yml down -v && docker compose -f apps/dev-env/docker-compose.yml up -d --build",
    "wcag": "node apps/wcag-compliance-viewer/scripts/run-wcag-workflow.mjs",
    "wcag:check": "node apps/wcag-compliance-viewer/scripts/run-wcag-workflow.mjs --check",
    "wcag:review-coverage": "node apps/wcag-compliance-viewer/scripts/review-wcag-coverage.mjs",
    "wcag:doctor": "node apps/wcag-compliance-viewer/scripts/wcag-doctor.mjs",
    "wcag:generate": "node apps/wcag-compliance-viewer/scripts/generate-wcag-report.mjs",
    "wcag:viewer": "node apps/wcag-compliance-viewer/scripts/open-or-start-viewer.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest --exclude '**/*.{integration,system}.{js,ts}'",
    "test:integration": "vitest --exclude '**/*.{test,system}.{js,ts}'",
    "test:system": "vitest --exclude '**/*.{test,integration}.{js,ts}'",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": ">=6.14.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "pg": "^8.20.0",
    "typescript": "^5.9.3",
    "winston": "^3.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
