{
  "name": "@slfcp/backend",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "build": "tsc --noEmitOnError false",
    "build:verbose": "tsc --listEmittedFiles --noEmitOnError false",
    "dev": "nodemon --exec \"npx tsx api/src/server.ts\"",
    "dev:old": "nodemon",
    "prod": "npx tsx api/src/server.ts",
    "prod:old": "node --import ./ts-node-loader.mjs api/src/server.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "set PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1&& set PRISMA_CLI_QUERY_ENGINE_TYPE=library&& prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:clean": "node --import ./ts-node-loader.mjs prisma/dev_utils/deleteAllTables.ts",
    "seed": "node --import ./ts-node-loader.mjs prisma/seeds/seed.ts",
    "generate-types": "openapi-typescript api/open_api_specs/openapi.yaml --output api/src/types/requests.ts",
    "check-connections": "tsx scripts/checkConnections.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/msal-node": "^3.7.0",
    "@azure/storage-blob": "^12.26.0",
    "@prisma/client": "^6.0.1",
    "@slfcp/emailer": "workspace:*",
    "@slfcp/logger": "workspace:^",
    "@slfcp/normalize-markdown": "workspace:*",
    "@slfcp/validation": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "axios": ">=1.16.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "fs": "0.0.1-security",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "morgan": "^1.10.0",
    "multer": ">=2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.0.5",
    "openapi-typescript": "^7.10.1",
    "path": "^0.12.7",
    "pg": "^8.13.1",
    "prisma": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.20.3",
    "uuid": ">=14.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@slfcp/utils": "workspace:*",
    "@tsconfig/node20": "^20.1.4",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/date-fns": "^2.6.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.9.2",
    "@types/node-cron": "^3.0.11",
    "dotenv-cli": "^7.4.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
