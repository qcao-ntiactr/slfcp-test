# Copy this to apps/frontend/.env.local before starting the frontend locally.

VITE_API_URL=http://localhost:3000
VITE_UNDER_MAINTENANCE=false
VITE_DASHBOARD_LIVE_DATA_ENABLED=false
VITE_ACCESS_TOKEN_EXPIRES_IN=900
VITE_REFRESH_TOKEN_EXPIRES_IN=86400
VITE_INACTIVITY_TIMEOUT=1800
VITE_SESSION_WARNING_TIME=300
VITE_TOKEN_REFRESH_INTERVAL=300
VITE_TOKEN_REFRESH_THRESHOLD=600
