# Copy this to apps/backend/.env before starting the backend locally.

PORT=3000
FRONTEND_URL=http://localhost:5173

# Local Postgres container.
DATABASE_URL=postgresql://slfcp:slfcp@localhost:5432/slfcp?schema=public

# Local Azurite container. docker compose initializes this account and container.
AZURE_BLOB_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=slfcpdev;AccountKey=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZg==;BlobEndpoint=http://127.0.0.1:10000/slfcpdev;QueueEndpoint=http://127.0.0.1:10001/slfcpdev;TableEndpoint=http://127.0.0.1:10002/slfcpdev;
CONTAINER_NAME=slfcp-uploads

# Local workflow replacement for the deployed Azure Logic App.
AZURE_WORKFLOW_URL=http://localhost:7071/api/workflow

# Local SMTP capture. Open http://localhost:8025 to inspect sent mail.
EMAIL_ENABLED=1
EMAIL_SERVER=localhost
EMAIL_PORT=1025
EMAIL_FROM=slfcp-local@example.test
EMAIL_SECURE=0

# Use built-in mock auth users instead of external Entra ID or Login.gov.
AUTH_MODE=mock
JWT_SECRET=local-dev-secret-change-me
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=86400

# Optional production integrations disabled for local development.
DASHBOARD_LIVE_DATA_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=
UNDER_MAINTENANCE=false
