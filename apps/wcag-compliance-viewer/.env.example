# WCAG Compliance Viewer environment template.
#
# Copy this file to:
#
#   apps/wcag-compliance-viewer/.env
#
# The generator loads this file before reading environment variables from the
# shell. Shell-provided values win over values in this file.
#
# Boolean options use string values:
#
#   true
#   false
#
# Numeric options are parsed with JavaScript Number(...).


# -----------------------------------------------------------------------------
# Required OpenAI configuration
# -----------------------------------------------------------------------------

# Required. Used by `pnpm wcag:generate` for AI-assisted assessment batches.
# Possible value: an OpenAI API key.
OPENAI_API_KEY=replace-me


# -----------------------------------------------------------------------------
# WCAG source document
# -----------------------------------------------------------------------------

# Optional. Absolute or repo-relative path to the VPAT/WCAG .docx source.
# If unset, the generator checks these paths in order:
#   docs/wcag-source.docx
#   docs/VPAT2.5Rev_WCAG_February2025_Draft.docx
#   VPAT2.5Rev_WCAG_February2025_Draft.docx
#
# Possible value: any .docx file path.
# WCAG_SOURCE_DOCX=docs/wcag-source.docx


# -----------------------------------------------------------------------------
# Local viewer
# -----------------------------------------------------------------------------

# Stable port used by `pnpm wcag:viewer`.
# The viewer command reuses an existing WCAG viewer on this port instead of
# starting duplicate Vite servers.
# Possible value: any available local TCP port.
WCAG_VIEWER_PORT=7357

# Stable host used by `pnpm wcag:viewer`.
# Possible values: localhost, 127.0.0.1, or another local bind host.
WCAG_VIEWER_HOST=localhost

# Open the viewer in the default browser when running `pnpm wcag:viewer`.
# Possible values: true, false.
WCAG_VIEWER_OPEN=true


# -----------------------------------------------------------------------------
# AI generation controls
# -----------------------------------------------------------------------------

# Model used for OpenAI report generation.
# Possible values: any OpenAI model available to the provided API key.
WCAG_AI_MODEL=gpt-5

# Number of WCAG criteria sent to the model in each batch.
# Higher values reduce batch count but increase prompt size and timeout risk.
# Possible values: positive integer.
WCAG_AI_BATCH_SIZE=4

# Maximum number of source files included in each AI batch prompt.
# Possible values: positive integer.
WCAG_AI_MAX_FILES=18

# Maximum characters included per source file in each AI batch prompt.
# Possible values: positive integer.
WCAG_AI_MAX_CHARS_PER_FILE=12000

# Number of retries after an OpenAI request failure.
# Total attempts = WCAG_AI_MAX_RETRIES + 1.
# Possible values: 0 or positive integer.
WCAG_AI_MAX_RETRIES=3

# Base retry delay in milliseconds. Attempt N waits N * this value.
# Possible values: 0 or positive integer.
WCAG_AI_RETRY_BASE_DELAY_MS=5000


# -----------------------------------------------------------------------------
# Playwright runtime evidence: global switches
# -----------------------------------------------------------------------------

# Enable browser-based runtime evidence collection.
# Possible values: true, false.
WCAG_PLAYWRIGHT_ENABLED=true

# Launch Chromium headless.
# Possible values:
#   true  - run without opening a visible browser
#   false - open a visible browser during collection
WCAG_PLAYWRIGHT_HEADLESS=true

# Maximum number of Tab key presses sampled per route/workflow focus pass.
# Possible values: positive integer.
WCAG_PLAYWRIGHT_MAX_TABS=25


# -----------------------------------------------------------------------------
# Playwright runtime evidence: target services
# -----------------------------------------------------------------------------

# Frontend URL to inspect.
# Possible value: any reachable local or remote frontend origin.
WCAG_PLAYWRIGHT_BASE_URL=http://localhost:5173

# Backend API URL used by the frontend and backend health checks.
# If unset, the generator falls back to VITE_API_URL, then http://localhost:3000.
# Possible value: any reachable backend API origin.
WCAG_PLAYWRIGHT_BACKEND_BASE_URL=http://localhost:3000

# Optional fallback used only when WCAG_PLAYWRIGHT_BACKEND_BASE_URL is unset.
# The managed frontend is also started with VITE_API_URL set to the backend URL.
# Possible value: any reachable backend API origin.
# VITE_API_URL=http://localhost:3000

# Optional comma-separated extra routes visited by the baseline runtime audit.
# By default, routes are discovered from the active router in apps/frontend/src/App.tsx.
# Possible values: app routes beginning with /.
# WCAG_PLAYWRIGHT_ROUTES=/,/dashboard,/view-requests,/create-request,/help,/common-conditions


# -----------------------------------------------------------------------------
# Playwright runtime evidence: managed service startup
# -----------------------------------------------------------------------------

# Automatically start the frontend if WCAG_PLAYWRIGHT_BASE_URL is not reachable.
# Possible values: true, false.
WCAG_PLAYWRIGHT_AUTOSTART_FRONTEND=true

# Time to wait for a managed frontend to become reachable, in milliseconds.
# Possible values: positive integer.
WCAG_PLAYWRIGHT_FRONTEND_STARTUP_TIMEOUT_MS=60000

# Automatically start the backend if WCAG_PLAYWRIGHT_BACKEND_BASE_URL is not reachable.
# Possible values: true, false.
WCAG_PLAYWRIGHT_AUTOSTART_BACKEND=true

# Prepare local backend environment files before managed backend startup.
# The generator may copy local env templates needed by the backend.
# Possible values: true, false.
WCAG_PLAYWRIGHT_PREPARE_DEV_ENV=true

# Backend auth mode used when the generator starts the backend.
# If unset, managed backend startup uses mock.
# Possible values are backend-dependent; known local option: mock.
AUTH_MODE=mock

# Time to wait for a managed backend to become reachable, in milliseconds.
# Possible values: positive integer.
WCAG_PLAYWRIGHT_BACKEND_STARTUP_TIMEOUT_MS=90000

# Run backend seed data before runtime collection.
# Usually false unless using a fresh local database.
# Possible values: true, false.
WCAG_PLAYWRIGHT_SEED_BACKEND=false

# Input sent to the backend seed command if WCAG_PLAYWRIGHT_SEED_BACKEND=true.
# Most users should leave this unset and use the generator default.
# Note: this .env loader is line-based and does not expand escaped "\n" into
# real newlines. For custom multiline seed input, prefer setting this from the
# shell or updating the generator default.
# WCAG_PLAYWRIGHT_BACKEND_SEED_INPUT=I\nD\nA\n10\nH\n10\nJ\n5\nK\nQ\n


# -----------------------------------------------------------------------------
# Playwright runtime evidence: authentication mode
# -----------------------------------------------------------------------------

# Force browser auth/config to mock mode and seed selected user into localStorage.
# This is the recommended local audit mode.
# Possible values:
#   true  - bypass real Entra/auth flows with mock user state
#   false - attempt UI login with configured email/password
WCAG_PLAYWRIGHT_FORCE_MOCK_AUTH=true

# Named login used by the baseline route audit.
# Possible values:
#   federal_navy
#   federal_nasa
#   commercial_qa
#   commercial_dev
#   ntia_qa
#   ntia_dev
#   spacex_user
#   sqa_commercial_spacetesting
#   sqa_federal_pshah_rw
#   sqa_federal_kbvreddy_comment
#   sqa_federal_vkchitty_admin
#   sqa_ntia_pshah_rw
WCAG_PLAYWRIGHT_LOGIN_USER=ntia_dev

# Backward-compatible direct credential overrides.
# If set, these override the selected named login email/password.
# Possible values: any email/password accepted by the target auth mode.
# WCAG_PLAYWRIGHT_EMAIL=ntia@dev.com
# WCAG_PLAYWRIGHT_PASSWORD=password123


# -----------------------------------------------------------------------------
# Playwright runtime evidence: role workflows
# -----------------------------------------------------------------------------

# Run scripted role-specific workflow routes in addition to baseline routes.
# Possible values: true, false.
WCAG_PLAYWRIGHT_WORKFLOWS_ENABLED=true

# Comma-separated named users used for role workflow collection.
# Possible values: any named login key listed in WCAG_PLAYWRIGHT_LOGIN_USER.
WCAG_PLAYWRIGHT_WORKFLOW_USERS=ntia_dev,commercial_dev,federal_navy


# -----------------------------------------------------------------------------
# Named mock login credential overrides
# -----------------------------------------------------------------------------
#
# Each named user has default metadata in generate-wcag-report.mjs.
# These variables only override the email/password values.
#
# Naming pattern:
#
#   WCAG_PLAYWRIGHT_LOGIN_<UPPERCASE_USER_KEY>_EMAIL
#   WCAG_PLAYWRIGHT_LOGIN_<UPPERCASE_USER_KEY>_PASSWORD

# federal_navy
WCAG_PLAYWRIGHT_LOGIN_FEDERAL_NAVY_EMAIL=federal@navy.gov
WCAG_PLAYWRIGHT_LOGIN_FEDERAL_NAVY_PASSWORD=password123

# federal_nasa
WCAG_PLAYWRIGHT_LOGIN_FEDERAL_NASA_EMAIL=federal@nasa.gov
WCAG_PLAYWRIGHT_LOGIN_FEDERAL_NASA_PASSWORD=password123

# commercial_qa
WCAG_PLAYWRIGHT_LOGIN_COMMERCIAL_QA_EMAIL=commercial@qa.com
WCAG_PLAYWRIGHT_LOGIN_COMMERCIAL_QA_PASSWORD=password123

# commercial_dev
WCAG_PLAYWRIGHT_LOGIN_COMMERCIAL_DEV_EMAIL=commercial@dev.com
WCAG_PLAYWRIGHT_LOGIN_COMMERCIAL_DEV_PASSWORD=password123

# ntia_qa
WCAG_PLAYWRIGHT_LOGIN_NTIA_QA_EMAIL=ntia@qa.com
WCAG_PLAYWRIGHT_LOGIN_NTIA_QA_PASSWORD=password123

# ntia_dev
WCAG_PLAYWRIGHT_LOGIN_NTIA_DEV_EMAIL=ntia@dev.com
WCAG_PLAYWRIGHT_LOGIN_NTIA_DEV_PASSWORD=password123

# spacex_user
WCAG_PLAYWRIGHT_LOGIN_SPACEX_USER_EMAIL=spacex@fakeserver123.com
WCAG_PLAYWRIGHT_LOGIN_SPACEX_USER_PASSWORD=password123

# sqa_commercial_spacetesting
WCAG_PLAYWRIGHT_LOGIN_SQA_COMMERCIAL_SPACETESTING_EMAIL=spacetesting@outlook.com
WCAG_PLAYWRIGHT_LOGIN_SQA_COMMERCIAL_SPACETESTING_PASSWORD=password123

# sqa_federal_pshah_rw
WCAG_PLAYWRIGHT_LOGIN_SQA_FEDERAL_PSHAH_RW_EMAIL=pshah@ctec-corp.com
WCAG_PLAYWRIGHT_LOGIN_SQA_FEDERAL_PSHAH_RW_PASSWORD=password123

# sqa_federal_kbvreddy_comment
WCAG_PLAYWRIGHT_LOGIN_SQA_FEDERAL_KBVREDDY_COMMENT_EMAIL=kbvreddy@yahoo.com
WCAG_PLAYWRIGHT_LOGIN_SQA_FEDERAL_KBVREDDY_COMMENT_PASSWORD=password123

# sqa_federal_vkchitty_admin
WCAG_PLAYWRIGHT_LOGIN_SQA_FEDERAL_VKCHITTY_ADMIN_EMAIL=vkchitty.ctr@ntia.gov
WCAG_PLAYWRIGHT_LOGIN_SQA_FEDERAL_VKCHITTY_ADMIN_PASSWORD=password123

# sqa_ntia_pshah_rw
WCAG_PLAYWRIGHT_LOGIN_SQA_NTIA_PSHAH_RW_EMAIL=pshah.ctr@ntia.gov
WCAG_PLAYWRIGHT_LOGIN_SQA_NTIA_PSHAH_RW_PASSWORD=password123
